# ─────────────────────────────────────────────────────────────────────────────
#  ZEUS — Environment Variables Template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  ⚠  Never commit .env to git — it is already listed in .gitignore
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL administrator used only for database maintenance
POSTGRES_PASSWORD=

# URL-safe password for the least-privilege app user; generate with secrets.token_hex(32)
POSTGRES_APP_PASSWORD=

# Port on the HOST machine that maps to postgres:5432 (avoid 5432 if already in use)
POSTGRES_PORT=5433

# Full connection string (used by the backend)
# Docker Compose sets this automatically — only override if running without Docker
# DATABASE_URL=postgresql://zeus:zeuspassword@localhost:5433/zeus


# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — CHANGE THIS TO A LONG RANDOM STRING IN PRODUCTION!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=


# ── Admin Account ─────────────────────────────────────────────────────────────
# Auto-created on first startup. Password is re-synced from env on every startup.
ADMIN_EMAIL=admin@zeus.local
ADMIN_PASSWORD=


# ── AI Providers (assign each provider to tasks in Admin settings) ────────────

# Groq Cloud — fastest free tier (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini (https://aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Groq is available but is not assigned to a task by default.


# ── YouTube Data API ──────────────────────────────────────────────────────────
# Required for video search, duration calculation, and study time estimates.
# Get a free key: console.cloud.google.com -> YouTube Data API v3 -> Enable -> Credentials
YOUTUBE_API_KEY=


# ── Application ───────────────────────────────────────────────────────────────
# Port on the HOST that maps to the ZEUS app (port 8000 inside container)
APP_PORT=8000

# CORS allowed origins (comma-separated). Keep the localhost entries for
# development; in production the nginx site https://zeusedu.tech is same-origin.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://zeusedu.tech,https://www.zeusedu.tech


# ── Production domain: https://zeusedu.tech ──────────────────────────────────
# nginx terminates TLS and proxies to 127.0.0.1:8000 (see nginx/zeusedu.tech.conf).
# Set this on the server so password-reset and OAuth redirects stay on HTTPS.
FRONTEND_URL=https://zeusedu.tech


# ── Google OAuth & Frontend URL ──────────────────────────────────────────────
# Needed for "Sign in with Google" flow
# Local dev:     GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Production:    GOOGLE_REDIRECT_URI=https://zeusedu.tech/api/auth/google/callback
# Add the exact URI you use to the Google Cloud console → OAuth client →
# "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zeusedu.tech/api/auth/google/callback

# Same client ID exposed to the Vite build (no secret). The SPA starts the flow
# through /api/auth/google/login, so this is optional and never needs the secret.
VITE_GOOGLE_CLIENT_ID=
